# Copie para .env e ajuste os valores locais. Nunca commitar o .env real.

# Banco de dados
DATABASE_URL=postgresql+psycopg://sigcpl:sigcpl@localhost:5432/sigcpl

# Segurança
SECRET_KEY=troque-este-valor-por-uma-chave-aleatoria-longa
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_SECURE=false

# Aplicação
ENVIRONMENT=development
DEBUG=true
APP_BASE_URL=http://127.0.0.1:8000

# E-mail (RF-004, recuperação de senha) — SMTP genérico, qualquer
# provedor que fale SMTP padrão (Gmail com senha de app, SES, Mailgun,
# um SMTP do próprio domínio, etc). SMTP_HOST vazio = e-mail não
# configurado (POST /esqueci-senha responde 500 até isto ser preenchido).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SIG-CPL <no-reply@sigcpl.local>
SMTP_USE_TLS=true
